    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst date = new Date(data.event_time);\n\nconst dateTime = date\n  .toISOString()\n  .slice(0, 19)\n  .replace('T', ' ');\n\nreturn {\n  json: {\n    ...data,\n    sigma_payload: {\n      events: [\n        {\n          eventId: `COBLI-${data.device_id}-${data.original_event_id}`,\n          code: \"F241\",\n          trackerId: data.device_id,\n          dateTime: dateTime,\n          complement: `Saída do bolsão ${data.local} - ${data.endereco}`\n        }\n      ]\n    }\n  }\n};"
      },
